# Copiar a frontend/.env si se necesita cambiar algo. No poner secretos aquí.

# URL de las teselas raster del mapa. Si se omite se usa la de OpenStreetMap,
# que es solo para desarrollo y pruebas: antes de publicar, usar teselas propias
# o de un proveedor con condiciones de uso claras (mantener la atribución).
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# URL base de la API del backend (aún no la consume el frontend).
VITE_API_URL=http://127.0.0.1:4000/api
