# Copiar a frontend/.env si se necesita cambiar algo. No poner secretos aquí.

# Archivo PMTiles del mapa (teselas propias, sin depender de OpenStreetMap).
# Ruta relativa al sitio o URL absoluta. Cómo generarlo: docs/MAPA-TESELAS.md
VITE_MAP_PMTILES_URL=/tiles/norte-de-santander.pmtiles

# URL base de la API del backend (aún no la consume el frontend).
VITE_API_URL=http://127.0.0.1:4000/api
