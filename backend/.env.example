# Copiar a backend/.env y cambiar los valores. No versionar .env.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=gramalote
MYSQL_USER=gramalote
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
DB_POOL_SIZE=10

# --- Autenticación del panel de administración ---
# Generar con: openssl rand -hex 32   (obligatorio si NODE_ENV=production)
JWT_SECRET=
AUTH_ACCESS_TTL=30m
AUTH_REFRESH_TTL_DAYS=7
# 1 cuando la API queda detrás de nginx/CloudFront (habilita cookies seguras)
TRUST_PROXY=0

# Cuenta que crea/actualiza `npm run seed:admin` (nunca versionar el .env real)
ADMIN_EMAIL=admin@gramalote.example
ADMIN_PASSWORD=cambie-esta-contrasena
ADMIN_NAME=Administrador

# --- Imágenes del panel (disco local, sin S3) ---
# MEDIA_ROOT apunta al volumen dentro del contenedor; en local, a ./media.
MEDIA_ROOT=
MEDIA_PUBLIC_BASE=/media
MEDIA_MAX_UPLOAD_MB=8
MEDIA_QUOTA_MB=500
MEDIA_VARIANTS=480,960,1440
